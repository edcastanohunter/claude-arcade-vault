# Resend (https://resend.com) — usado por app/api/contact/route.ts.
# Sin esta clave, en desarrollo el endpoint entra en modo mock (loguea el
# mensaje en consola y responde éxito); en producción responde 500.
RESEND_API_KEY=

# Dirección a la que llegan los mensajes del formulario de contacto (/about).
CONTACT_TO_EMAIL=

# Supabase (https://supabase.com) — catálogo, autenticación y puntuaciones.
# Ambas son públicas por diseño (prefijo NEXT_PUBLIC_): se exponen al cliente
# y quedan protegidas por las políticas de RLS de cada tabla, no por secreto.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
